#!/bin/bash

ABSPATH=$(cd "${0%/*}" && echo "$(pwd)/${0##*/}")
CWD=$(dirname "$ABSPATH")

DRY_RUN=false
if [[ "$1" == "--dry-run" ]]; then
    DRY_RUN=true
fi

function link {
    srcfile="$CWD/$1"

    if $DRY_RUN; then
        echo "$srcfile"
    else
        ln -sfnv "$srcfile" "$HOME/"
    fi
}

shopt -s nullglob

for file in .*; do
    if [ . != "$file" ] && [ .. != "$file" ] && [ '.gitignore' != "$file" ] && [ '.git' != "$file" ] && [ '.claude' != "$file" ] && [ 'swp' != "${file##*.}" ]; then
        link "$file"
    fi
done

mkdir -p "$HOME/bin"
for file in bin/*; do
    if $DRY_RUN; then
        echo "$CWD/$file"
    elif [ ! -L "$HOME/$file" ]; then
        ln -sfnv "$CWD/$file" "$HOME/$file"
    fi
done

# Claude Code
mkdir -p "$HOME/.claude"

for name in settings.json hooks CLAUDE.md statusline.sh; do
    if $DRY_RUN; then
        echo "$CWD/.claude/$name"
    elif [ -e "$HOME/.claude/$name" ] && [ ! -L "$HOME/.claude/$name" ]; then
        echo "Warning: $HOME/.claude/$name already exists and is not a symlink, skipping."
    else
        ln -sfnv "$CWD/.claude/$name" "$HOME/.claude/$name"
    fi
done

if ! $DRY_RUN; then
    osascript -e 'display notification "dotfiles 設定完成" with title "dotfiles setup ✅" sound name "Glass"' || true
fi
